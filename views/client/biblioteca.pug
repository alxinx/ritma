extends base.pug

block content
    //- R2 URL para el JS (grid de artistas)
    script.
        window.__R2_URL__ = "#{R2_PUBLIC_URL}";
    script(src="/js/clientBiblioteca.js")
    div(class="flex flex-col lg:flex-row gap-6 min-h-screen")

        //- ==========================================
        //- COLUMNA IZQUIERDA (70%)
        //- ==========================================
        div(class="w-full lg:w-[70%] space-y-4")

            //- Header card
            div(class="relative overflow-hidden rounded-2xl p-6" style="background: linear-gradient(135deg, rgba(201,218,43,0.06) 0%, rgba(0,0,0,0.9) 60%); border: 1px solid rgba(201,218,43,0.10);")
                div(class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-primary/30 to-transparent")
                div(class="flex items-center gap-4")
                    span(class="material-symbols-outlined text-primary text-4xl") library_music
                    div
                        h1(class="text-2xl font-display font-black uppercase tracking-tight text-white") Mi Biblioteca
                        p(class="text-white/30 text-xs font-mono uppercase tracking-widest mt-1") #{totalDescargas || 0} archivos descargados

            //- Buscador
            div(class="relative group")
                span(class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-xl text-primary/50 group-focus-within:text-primary transition-colors") search
                input#bib-search(
                    type="text"
                    placeholder="Buscar en mi biblioteca..."
                    autocomplete="off"
                    class="w-full pl-12 pr-4 py-4 bg-white/4 border border-white/10 rounded-xl text-white text-sm font-medium placeholder:text-white/20 focus:outline-none focus:border-primary/40 transition-all"
                )

            //- Pills de generos del usuario
            div(class="flex flex-wrap gap-2 items-center")
                button(id="pill-todos" class="genre-pill-btn active px-4 py-1.5 text-[10px] font-bold uppercase tracking-widest rounded-full transition-all bg-primary text-black border border-primary" data-id="all") Todos
                each g in generosBiblioteca
                    button(class="genre-pill-btn px-3 py-1.5 text-[10px] font-bold uppercase tracking-widest rounded-full border border-white/15 text-white/40 hover:border-primary/40 hover:text-primary transition-all" data-id=g.genero_id)
                        | #{g.nombre}

            //- Tabla de resultados
            div#bib-container(class="modular-card rounded-2xl overflow-hidden")

                //- Skeleton loader (visible por defecto)
                div#bib-skeleton
                    table(class="w-full")
                        thead
                            tr(class="border-b border-white/5 bg-white/2")
                                th(class="px-4 py-3 w-8")
                                th(class="px-4 py-3 text-[9px] font-mono text-primary uppercase text-left" style="width:20%") Artista
                                th(class="px-4 py-3 text-[9px] font-mono text-primary uppercase text-left" style="width:30%") Composicion
                                th(class="px-4 py-3 text-[9px] font-mono text-primary uppercase text-left" style="width:20%") Detalles
                                th(class="px-4 py-3 text-[9px] font-mono text-primary uppercase text-center" style="width:16%") Acciones
                    div(class="divide-y divide-white/5")
                        each i in [1,2,3,4,5,6,7,8]
                            div(class="flex items-center gap-4 px-4 py-3 animate-pulse")
                                div(class="w-7 h-7 rounded-lg bg-white/5 shrink-0")
                                div(class="w-24 h-4 bg-white/5 rounded")
                                div(class="flex-1 space-y-2")
                                    div(class="h-4 bg-white/5 rounded w-3/4")
                                    div(class="h-2 bg-white/3 rounded w-1/3")
                                div(class="w-20 h-4 bg-white/5 rounded")
                                div(class="flex gap-2")
                                    div(class="w-7 h-7 bg-white/5 rounded-full")
                                    div(class="w-7 h-7 bg-white/5 rounded-full")
                                    div(class="w-7 h-7 bg-white/5 rounded-full")

                //- Tabla real (oculta hasta cargar)
                div#bib-table-wrapper(class="hidden")
                    table(class="w-full text-left")
                        thead
                            tr(class="border-b border-white/5 bg-white/2")
                                th(class="px-4 py-3 w-8")
                                th(class="px-4 py-3 text-[9px] font-mono text-primary uppercase" style="width:20%") Artista
                                th(class="px-4 py-3 text-[9px] font-mono text-primary uppercase" style="width:30%") Composicion
                                th(class="px-4 py-3 text-[9px] font-mono text-primary uppercase" style="width:20%") Detalles
                                th(class="px-4 py-3 text-[9px] font-mono text-primary uppercase text-center" style="width:16%") Acciones
                        tbody#bib-tbody

                    //- Paginacion
                    div(class="flex items-center justify-between px-4 py-3 border-t border-white/5")
                        span#bib-total(class="text-[10px] font-mono text-white/30")
                        div#bib-pages(class="flex gap-1")

                //- Empty state
                div#bib-empty(class="hidden text-center py-16")
                    span(class="material-symbols-outlined text-6xl text-white/5 mb-4 block") search_off
                    p(class="text-white/20 text-xs font-mono uppercase tracking-widest") Sin resultados en tu biblioteca

        //- ==========================================
        //- COLUMNA DERECHA (30%) — Directorio de artistas
        //- ==========================================
        div(class="w-full lg:w-[30%]")
            div(class="rounded-2xl border border-white/10 overflow-hidden sticky top-4" style="background: rgba(255,255,255,0.03);")
                //- Header
                div(class="flex items-center justify-between px-5 py-4 bg-primary")
                    h3(class="text-[11px] font-bold uppercase tracking-widest text-black") Mis Artistas
                    span(class="material-symbols-outlined text-black/60 text-lg") people

                div(class="p-4")
                    //- Buscador interno (visible si >10 artistas)
                    if artistasBiblioteca && artistasBiblioteca.length > 10
                        div(class="relative mb-3")
                            span(class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-sm text-white/30") search
                            input#artista-search-input(
                                type="text"
                                placeholder="Buscar artista..."
                                class="w-full pl-9 pr-3 py-2 bg-white/5 border border-white/10 rounded-lg text-xs text-white placeholder:text-white/20 focus:outline-none focus:border-primary/30 transition-all"
                            )

                    //- Grid de artistas con scroll y lazy load
                    div#artistas-grid(class="grid grid-cols-3 gap-2 overflow-y-auto max-h-[600px] custom-scrollbar")
                        //- Skeleton inicial
                        each i in [1,2,3,4,5,6,7,8,9]
                            div(class="artista-skeleton flex flex-col items-center gap-1 p-2 animate-pulse")
                                div(class="w-16 h-16 rounded-full bg-white/5")
                                div(class="h-2 bg-white/5 rounded w-12")
