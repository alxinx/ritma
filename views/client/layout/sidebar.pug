//- Sidebar Navigation — User Panel
aside#sidebar(class="fixed h-screen border border-primary/4 bg-surface-dark/40 shadow-2xl flex flex-col p-4 lg:p-6 z-51 w-20 lg:w-72")

    //- Logo Section
    div(class="flex items-center justify-center lg:justify-start gap-3 mb-12 cursor-pointer" id="sidebarToggle")
        div(class="size-10 flex items-center justify-center rounded shrink-0")
            img(src="/img/logos/isotipo.png" alt="RITMA")
        div(class="hidden lg:block sidebar-text")
            h1(class="text-white text-xl font-bold tracking-tighter uppercase leading-none") RITMA
            p(class="text-primary/60 text-[10px] uppercase tracking-widest font-bold") #{process.env.APP_VERSION}

    //- Nav Section
    nav(class="space-y-2 sidebar-nav")
        -
            const menuItems = [
                {k:'home', i:'search', t:'Home & Search', h:'/ritmaap/'},
                {k:'biblioteca', i:'library_music', t:'Mi Biblioteca', h:'/ritmaap/biblioteca'},
                {k:'favoritos', i:'favorite', t:'Mis Favoritos', h:'/ritmaap/favoritos'},
                {k:'wishlist', i:'bookmark', t:'Mi Wishlist', h:'/ritmaap/wishlist'},
                {k:'creditos', i:'credit_card_heart', t:'Creditos', h:'/ritmaap/creditos'},
                {k:'settings', i:'settings', t:'Settings', h:'/ritmaap/settings'}
            ];

        each item in menuItems
            - const isActive = active === item.k
            a(
                class=`flex items-center gap-3 px-4 py-3 rounded-lg transition-all ${
                    isActive
                        ? 'bg-primary/10 text-primary border border-primary/20'
                        : 'text-white/60 hover:text-white hover:bg-white/5'
                }`
                href=item.h
                title=item.t
            )
                span(class="material-symbols-outlined text-xl") #{item.i}
                h4(class="text-sm font-medium whitespace-nowrap sidebar-text") #{item.t}

    //- Footer / Logout
    div(class="mt-auto pt-6 border-t border-white/10 sidebar-footer")
        form(action="/app/logout" method="POST" class="w-full")
            input(type="hidden" name="_csrf" value=csrfToken)
            +btnSubmit("close", "close", "Cerrar Sesion", "exit_to_app")

//- Mobile sidebar toggle
script.
    (function() {
        const sidebar = document.getElementById('sidebar');
        const toggle = document.getElementById('sidebarToggle');
        if (!sidebar || !toggle) return;
        toggle.addEventListener('click', function() {
            if (window.innerWidth >= 1024) return;
            sidebar.classList.toggle('open');
        });
        document.addEventListener('click', function(e) {
            if (window.innerWidth >= 1024) return;
            if (!sidebar.contains(e.target) && sidebar.classList.contains('open')) {
                sidebar.classList.remove('open');
            }
        });
    })();
