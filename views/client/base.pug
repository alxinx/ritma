include ../layout/head.pug
include ../components/mixins/form-field.pug
include ../components/mixins/layouts.pug
block contenedor
    meta(name="csrf-token" content=csrfToken)

    div(class="flex min-h-screen")

        //- SIDEBAR
        include layout/sidebar.pug

        main(class="flex-1 ml-[60px] lg:ml-72 min-h-screen")
            //- HEADER
            include layout/headerUser.pug

            //- BODY
            div(class="mx-auto p-4 pb-32")
                block content

            //- FOOTER
            include layout/footer.pug

    script(src="/js/clientPanel.js")

    //- Slot para modales que necesitan z-index global (fuera del stacking context del layout)
    block modals
