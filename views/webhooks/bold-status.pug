doctype html
html(lang="es")
    head
        meta(charset="utf-8")
        meta(name="viewport" content="width=device-width, initial-scale=1")
        title #{tituloPagina} — RITMA
        link(rel="stylesheet" href="/css/output.css")
        link(rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200")
        link(rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&display=swap")
        style.
            body { font-family: 'Space Grotesk', sans-serif; background: #000; }
    body(class="min-h-screen flex items-center justify-center p-4" style="background: linear-gradient(135deg, #050510 0%, #0a0a0c 50%, #080812 100%);")

        div(class="w-full max-w-md")

            //- Card principal
            div(class="rounded-2xl overflow-hidden" style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08);")

                //- Header con icono de estado
                div(class="p-8 text-center" style=status === 'APPROVED' ? 'background: rgba(34,197,94,0.06);' : status === 'REJECTED' || status === 'DECLINED' || status === 'FAILED' ? 'background: rgba(239,68,68,0.06);' : 'background: rgba(234,179,8,0.06);')

                    if status === 'APPROVED'
                        div(class="inline-flex items-center justify-center size-16 rounded-full mb-4" style="background: rgba(34,197,94,0.12); border: 1px solid rgba(34,197,94,0.25);")
                            span(class="material-symbols-outlined text-green-400 text-3xl") check_circle
                        h2(class="font-display font-black text-2xl uppercase tracking-tight text-green-400") Pago Aprobado
                        p(class="text-white/40 text-sm mt-2") Tus créditos ya están disponibles

                    else if status === 'REJECTED' || status === 'DECLINED' || status === 'FAILED'
                        div(class="inline-flex items-center justify-center size-16 rounded-full mb-4" style="background: rgba(239,68,68,0.12); border: 1px solid rgba(239,68,68,0.25);")
                            span(class="material-symbols-outlined text-red-400 text-3xl") cancel
                        h2(class="font-display font-black text-2xl uppercase tracking-tight text-red-400") Pago Rechazado
                        p(class="text-white/40 text-sm mt-2") Tu método de pago fue rechazado

                    else
                        div(class="inline-flex items-center justify-center size-16 rounded-full mb-4" style="background: rgba(234,179,8,0.12); border: 1px solid rgba(234,179,8,0.25);")
                            span(class="material-symbols-outlined text-yellow-400 text-3xl") schedule
                        h2(class="font-display font-black text-2xl uppercase tracking-tight text-yellow-400") Procesando
                        p(class="text-white/40 text-sm mt-2") Tu pago está siendo verificado

                //- Detalles
                div(class="p-6 space-y-3")
                    if nombrePack
                        div(class="flex items-center justify-between py-2")
                            span(class="text-white/30 text-xs font-mono uppercase tracking-widest") Pack
                            span(class="text-white text-sm font-bold") #{nombrePack}

                    if nroCreditos
                        div(class="flex items-center justify-between py-2")
                            span(class="text-white/30 text-xs font-mono uppercase tracking-widest") Créditos
                            span(class="text-primary text-sm font-bold") +#{nroCreditos}

                    if reference
                        div(class="flex items-center justify-between py-2" style="border-top: 1px solid rgba(255,255,255,0.05);")
                            span(class="text-white/30 text-xs font-mono uppercase tracking-widest") Referencia
                            span(class="text-white/40 text-[10px] font-mono") #{reference}

                //- Botón volver
                div(class="p-6 pt-0")
                    a(href="/ritmaap/creditos" class="block w-full py-3.5 rounded-xl text-center font-display font-bold text-sm uppercase tracking-widest transition-all hover:brightness-110" style=status === 'APPROVED' ? 'background: rgba(34,197,94,0.15); color: #22C55E; border: 1px solid rgba(34,197,94,0.2);' : 'background: rgba(201,218,43,0.1); color: #C9DA2B; border: 1px solid rgba(201,218,43,0.15);')
                        | Ir a Mis Créditos

            //- Footer
            p(class="text-white/10 text-[8px] font-mono text-center mt-4 uppercase tracking-widest") Procesado por Bold • RITMA Digital Systems
