div(class="glass-card rounded-3xl p-8 relative overflow-hidden group")
  h3(class="text-[11px] font-bold text-gray-400 uppercase tracking-[0.3em] mb-4") Nuevos este mes
  div(class="flex items-center gap-3 mb-6")
    span(class="text-4xl font-display font-extrabold") +#{nuevosEsteMes || 0}
    if tendenciaNuevos && tendenciaNuevos.direccion === 'up'
      span(class="text-green-400 text-xs font-bold flex items-center")
        span(class="material-symbols-outlined text-sm") trending_up
        |  #{tendenciaNuevos.porcentaje}%
    else if tendenciaNuevos && tendenciaNuevos.direccion === 'down'
      span(class="text-red-400 text-xs font-bold flex items-center")
        span(class="material-symbols-outlined text-sm") trending_down
        |  #{tendenciaNuevos.porcentaje}%
    else
      span(class="text-white/40 text-xs font-bold flex items-center")
        span(class="material-symbols-outlined text-sm") trending_flat
        |  0%
  div#chart-nuevos(class="relative h-24 w-full")
    svg(class="w-full h-full overflow-visible" preserveAspectRatio="none" viewBox="0 0 100 30")
      path#chart-line(
        d="M0 25 Q10 22 20 25 T40 18 T60 22 T80 12 T100 5"
        fill="none"
        stroke="#C9DA2B"
        stroke-width="2"
        vector-effect="non-scaling-stroke"
      )
      path#chart-area(
        d="M0 25 Q10 22 20 25 T40 18 T60 22 T80 12 T100 5 V30 H0 Z"
        fill="url(#gradient-chart)"
        opacity="0.1"
      )
      defs
        linearGradient(id="gradient-chart" x1="0" x2="0" y1="0" y2="1")
          stop(offset="0%" stop-color="#C9DA2B")
          stop(offset="100%" stop-color="transparent")

  script.
    (function() {
      try {
        const datos = !{aspirantesPorDia};
        if (!datos || datos.length === 0) return;
        const maxVal = Math.max(...datos.map(d => d.total), 1);
        const points = datos.map((d, i) => {
          const x = (i / Math.max(datos.length - 1, 1)) * 100;
          const y = 28 - (d.total / maxVal) * 26;
          return `${x} ${y}`;
        });
        const lineD = 'M' + points.join(' L');
        const areaD = lineD + ' V30 H0 Z';
        const lineEl = document.getElementById('chart-line');
        const areaEl = document.getElementById('chart-area');
        if (lineEl) lineEl.setAttribute('d', lineD);
        if (areaEl) areaEl.setAttribute('d', areaD);
      } catch(e) {}
    })();
