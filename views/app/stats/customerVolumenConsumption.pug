div(class="glass-card rounded-3xl p-8 lg:col-span-2")
  div(class="flex items-center justify-between mb-8")
    h3(class="text-[11px] font-bold text-gray-400 uppercase tracking-[0.3em]") Top Consumers (DL Volume)
    span(class="text-[10px] font-bold text-primary/60") ÚLTIMO MES

  if topConsumers && topConsumers.length > 0
    div(class="grid grid-cols-1 md:grid-cols-3 gap-8")
      each consumer in topConsumers
        - const offset = 100 - consumer.porcentaje
        div(class="flex items-center gap-4 bg-white/5 p-4 rounded-2xl border border-white/5 group hover:border-primary/30 transition-all")
          div(class="relative size-14 shrink-0")
            svg(class="size-full -rotate-90" viewBox="0 0 36 36")
              circle(cx="18" cy="18" fill="none" r="16" stroke="rgba(255,255,255,0.05)" stroke-width="3")
              circle(cx="18" cy="18" fill="none" r="16" stroke="#C9DA2B" stroke-dasharray="100" stroke-dashoffset=offset stroke-linecap="round" stroke-width="3")
            div(class="absolute inset-0 flex items-center justify-center text-[10px] font-black") #{consumer.porcentaje}%
          div(class="min-w-0")
            p(class="text-sm font-bold truncate") #{consumer.nombre} #{consumer.apellido}
            p(class="text-[10px] text-primary font-mono") #{consumer.totalGB} GB
  else
    div(class="flex items-center justify-center h-32 text-white/20 text-xs uppercase tracking-widest")
      | Sin datos de consumo este mes
