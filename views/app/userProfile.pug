include ../layout/head.pug
include ../components/mixins/form-field.pug
include ../components/mixins/layouts.pug
block contenedor

    div(class="flex min-h-screen")

        //- MENU LATERAL
        include layout/leftMenu.pug
        main(class="flex-1 ml-[60px] lg:ml-72 min-h-screen")
            //- HEADER
            include layout/headerAdmin.pug

            //- BODY
            div(class="mx-auto p-4 pb-32")

                //- BREADCRUMB
                div(class="flex items-center gap-2 text-[10px] font-bold uppercase tracking-widest text-white/30 mb-6")
                    a(href="/app/dash/users" class="hover:text-primary transition-colors") Usuarios
                    span /
                    span.text-white/60 #{usuario.nombreUsuario} #{usuario.apellidoUsuario}

                //- LAYOUT: Profile Card (left) + Stats & Library (right)
                section(class="grid grid-cols-1 lg:grid-cols-12 gap-8")

                    //- LEFT: Profile Card
                    div(class="lg:col-span-4")
                        include layout/userProfileCard.pug

                    //- RIGHT: Stats + Download Library
                    div(class="lg:col-span-8 space-y-8")

                        //- STATS ROW
                        section(class="grid grid-cols-1 md:grid-cols-3 gap-6")
                            include stats/userStatDownloads.pug
                            include stats/userStatCreditsAvailable.pug
                            include stats/userStatCreditsSpent.pug

                        //- DOWNLOAD LIBRARY
                        include layout/userDownloadLibrary.pug

    include layout/footer.pug

    //- MODAL: Agregar Créditos
    div#modal-creditos(class="fixed inset-0 z-[3000] flex items-center justify-center bg-black/80 hidden")
        div(class="glass-card w-full max-w-md mx-4 p-8 border border-white/10 relative rounded-3xl")
            button#close-modal-creditos(class="absolute top-4 right-4 text-white/40 hover:text-white transition-colors")
                span(class="material-symbols-outlined") close
            h3(class="font-display font-black text-xl uppercase tracking-tighter mb-6") Agregar Créditos
            div(class="space-y-4")
                div
                    label(class="text-[10px] font-bold uppercase tracking-widest text-white/40 mb-2 block") Cantidad de créditos
                    input#input-creditos(type="number" min="1" max="5000" placeholder="Ej: 100" class="ritma-input-field w-full")
                div#campo-codigo-admin(class="hidden")
                    label(class="text-[10px] font-bold uppercase tracking-widest text-white/40 mb-2 block") Código de administrador
                    input#input-codigo-admin(type="password" placeholder="Código requerido (+500/día)" class="ritma-input-field w-full")
                    p(class="text-[9px] text-ritma-orange mt-1") Se requiere código para asignar más de 500 créditos en un día
            div(class="flex justify-end gap-3 mt-8")
                button#btn-cancelar-creditos(class="px-6 py-3 text-[10px] font-bold uppercase tracking-widest text-white/40 hover:text-white transition-colors") Cancelar
                button#btn-confirmar-creditos(class="px-6 py-3 bg-primary text-black font-display font-bold text-[10px] uppercase tracking-widest rounded hover:bg-white transition-colors") Confirmar

    //- MODAL: Editar Datos
    div#modal-editar(class="fixed inset-0 z-[3000] flex items-center justify-center bg-black/80 hidden")
        div(class="glass-card w-full max-w-lg mx-4 p-8 border border-white/10 relative rounded-3xl max-h-[90vh] overflow-y-auto custom-scrollbar")
            button#close-modal-editar(class="absolute top-4 right-4 text-white/40 hover:text-white transition-colors")
                span(class="material-symbols-outlined") close
            h3(class="font-display font-black text-xl uppercase tracking-tighter mb-6") Editar Datos
            div(class="space-y-4")
                div(class="grid grid-cols-2 gap-4")
                    div
                        label(class="text-[10px] font-bold uppercase tracking-widest text-white/40 mb-2 block") Nombre
                        input#edit-nombre(type="text" value=usuario.nombreUsuario class="ritma-input-field w-full")
                    div
                        label(class="text-[10px] font-bold uppercase tracking-widest text-white/40 mb-2 block") Apellido
                        input#edit-apellido(type="text" value=usuario.apellidoUsuario class="ritma-input-field w-full")
                div
                    label(class="text-[10px] font-bold uppercase tracking-widest text-white/40 mb-2 block") Nueva contraseña
                    input#edit-password(type="password" placeholder="Dejar vacío para no cambiar" class="ritma-input-field w-full")
                hr(class="border-white/5")
                p(class="text-[9px] font-bold uppercase tracking-widest text-white/20") Datos de contacto
                div(class="grid grid-cols-2 gap-4")
                    div
                        label(class="text-[10px] font-bold uppercase tracking-widest text-white/40 mb-2 block") WhatsApp
                        input#edit-whatsapp(type="text" value=(aspirante ? aspirante.whatsappAspirante : '') class="ritma-input-field w-full")
                    div
                        label(class="text-[10px] font-bold uppercase tracking-widest text-white/40 mb-2 block") Ciudad
                        input#edit-ciudad(type="text" value=(aspirante ? aspirante.ciudadAspirante || '' : '') class="ritma-input-field w-full")
                div(class="grid grid-cols-2 gap-4")
                    div
                        label(class="text-[10px] font-bold uppercase tracking-widest text-white/40 mb-2 block") Instagram
                        input#edit-instagram(type="text" value=(aspirante ? aspirante.instagramAspirante || '' : '') class="ritma-input-field w-full")
                    div
                        label(class="text-[10px] font-bold uppercase tracking-widest text-white/40 mb-2 block") TikTok
                        input#edit-tiktok(type="text" value=(aspirante ? aspirante.tiktokAspirante || '' : '') class="ritma-input-field w-full")
            div(class="flex justify-end gap-3 mt-8")
                button#btn-cancelar-editar(class="px-6 py-3 text-[10px] font-bold uppercase tracking-widest text-white/40 hover:text-white transition-colors") Cancelar
                button#btn-confirmar-editar(class="px-6 py-3 bg-primary text-black font-display font-bold text-[10px] uppercase tracking-widest rounded hover:bg-white transition-colors") Guardar

    //- MODAL: Historial de Créditos
    div#modal-credit-history(class="fixed inset-0 z-[3000] flex items-center justify-center bg-black/80 hidden")
        div(class="glass-card w-full max-w-2xl mx-4 p-8 border border-white/10 relative rounded-3xl max-h-[80vh] overflow-y-auto custom-scrollbar")
            button#close-modal-credit-history(class="absolute top-4 right-4 text-white/40 hover:text-white transition-colors")
                span(class="material-symbols-outlined") close
            h3(class="font-display font-black text-xl uppercase tracking-tighter mb-6") Historial de Créditos
            div(class="overflow-x-auto")
                table(class="w-full")
                    thead
                        tr(class="border-b border-white/5")
                            th(class="px-4 py-3 text-left text-[10px] font-bold uppercase tracking-widest text-white/30") Fecha de Compra
                            th(class="px-4 py-3 text-right text-[10px] font-bold uppercase tracking-widest text-white/30") Comprados
                            th(class="px-4 py-3 text-right text-[10px] font-bold uppercase tracking-widest text-white/30") Disponibles
                            th(class="px-4 py-3 text-right text-[10px] font-bold uppercase tracking-widest text-white/30") Último Uso
                    tbody#credit-history-tbody
                        //- Rendered by JS
            div#credit-history-empty(class="text-center py-10 text-white/20 text-[10px] font-bold uppercase tracking-widest hidden")
                span(class="material-symbols-outlined text-4xl block mb-2") account_balance_wallet
                | Sin historial de créditos

    //- MODAL: Wishlist
    div#modal-wishlist(class="fixed inset-0 z-[3000] flex items-center justify-center bg-black/80 hidden")
        div(class="glass-card w-full max-w-2xl mx-4 p-8 border border-white/10 relative rounded-3xl max-h-[80vh] overflow-y-auto custom-scrollbar")
            button#close-modal-wishlist(class="absolute top-4 right-4 text-white/40 hover:text-white transition-colors")
                span(class="material-symbols-outlined") close
            h3(class="font-display font-black text-xl uppercase tracking-tighter mb-6") Wishlist
            div#wishlist-list(class="space-y-3")
                //- Rendered by JS
            div#wishlist-empty(class="text-center py-10 text-white/20 text-[10px] font-bold uppercase tracking-widest hidden")
                span(class="material-symbols-outlined text-4xl block mb-2") favorite
                | No hay items en la wishlist

    script.
        window.__USERPROFILE__ = {
            csrfToken: "#{csrfToken}",
            idUsuario: "#{usuario.idUsuario}",
            estado: "#{usuario.estado}"
        };
    script(src="/js/userProfile.js")
