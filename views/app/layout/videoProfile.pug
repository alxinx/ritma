main(class="pt-4 pb-20 relative")
  div(class="absolute inset-0 pixel-grid opacity-20 pointer-events-none")

  div(class="max-w-[1400px] mx-auto px-6 relative z-10")
    //- Breadcrumbs
    div(class="flex items-center gap-2 text-[10px] font-bold uppercase tracking-widest text-slate-500 mb-6")
      a(class="hover:text-white transition-colors" href="/app/dash/multimedia") MULTIMEDIA
      span(class="material-symbols-outlined text-sm") chevron_right
      span(class="text-primary") #{multimedia.nombreComposicion}

    div(class="grid grid-cols-1 lg:grid-cols-4 gap-6 mb-12")
      //- Video Player Column
      div(class="lg:col-span-3 space-y-6")
        div(class="relative aspect-video bg-surface-dark border border-white/10 video-glow overflow-hidden group")
          if multimedia.keyPreview || multimedia.keyOriginal
            video(id="video-player" class="w-full h-full object-cover" src=`/app/dash/api/preview/${multimedia.idMultimedia}` poster=coverUrl preload="metadata")
          else
            video(id="video-player" class="w-full h-full object-cover" poster=coverUrl preload="none")

          //- Video Controls Overlay
          div(class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent flex flex-col justify-end p-6")
            div(class="flex items-center justify-between w-full")
              div(class="flex items-center gap-6")
                button(id="btn-play-pause" class="text-white hover:text-primary transition-colors")
                  span(id="play-icon" class="material-symbols-outlined text-4xl") play_arrow
                div(id="video-progress-bar" class="h-1 w-64 md:w-96 bg-white/20 relative cursor-pointer group/bar")
                  div(id="video-progress" class="absolute top-0 left-0 h-full w-0 bg-primary shadow-[0_0_10px_#C9DA2B]")
                  div(id="video-seek-dot" class="absolute top-1/2 -translate-y-1/2 w-3 h-3 bg-primary rounded-full shadow-[0_0_8px_#C9DA2B] opacity-0 group-hover/bar:opacity-100 transition-opacity pointer-events-none" style="left: 0%")
                span(id="video-time" class="font-mono text-[11px] tracking-tighter")
                  | 00:00 /
                  if multimedia.duracion
                    - const mins = Math.floor(multimedia.duracion / 60)
                    - const secs = multimedia.duracion % 60
                    |  #{String(mins).padStart(2,'0')}:#{String(secs).padStart(2,'0')}
                  else
                    |  --:--
              div(class="flex items-center gap-4")
                span(class="px-2 py-0.5 border border-primary text-primary text-[10px] font-bold") #{multimedia.formato ? multimedia.formato.toUpperCase() : 'VIDEO'}
                button(id="btn-fullscreen" class="text-white hover:text-primary transition-colors")
                  span(class="material-symbols-outlined") fullscreen

          //- Status Badge
          div(class="absolute top-6 left-6 flex items-center gap-2 px-3 py-1 bg-black/60 backdrop-blur-md border border-white/10")
            if multimedia.estado === 'ENABLE'
              div(class="w-2 h-2 rounded-full bg-primary animate-pulse")
              span(class="text-[10px] font-bold tracking-[0.2em] uppercase") On-line
            else
              div(class="w-2 h-2 rounded-full bg-red-500")
              span(class="text-[10px] font-bold tracking-[0.2em] uppercase text-red-400") Suspendido

        //- Video Info Header
        div(class="flex flex-col md:flex-row md:items-center justify-between gap-4")
          div
            h1(class="font-display font-extrabold text-4xl md:text-5xl uppercase tracking-tighter leading-none mb-3")
              | #{multimedia.nombreComposicion}
            div(class="flex flex-wrap gap-4 text-slate-400 text-xs font-medium uppercase tracking-widest")
              span(class="flex items-center gap-1")
                span(class="material-symbols-outlined text-sm") person
                | #{multimedia.ARTISTA ? multimedia.ARTISTA.nombreArtista : 'Sin artista'}
              span(class="flex items-center gap-1")
                span(class="material-symbols-outlined text-sm") schedule
                | #{new Date(multimedia.createdAt).toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' })}
              span(class="flex items-center gap-1 text-primary")
                span(class="material-symbols-outlined text-sm") currency_rupee_circle
                | #{multimedia.costoCreditos} Créditos

      //- Sidebar Stats
      div(class="lg:col-span-1 md:col-span-3")
        div(class="glass-card border border-white/10 p-6 h-full")
          h3(class="font-display font-bold text-[10px] uppercase tracking-[0.2em] text-slate-500 flex items-center gap-2")
          span(class="material-symbols-outlined mr-3 mt-1 mb-5") stacked_line_chart
          | ESTADÍSTICAS TÉCNICAS

          div(class="space-y-2")
            div(class="grid grid-cols-2 gap-4")
              div(class="boxStatsVideo text-center")
                p Créditos
                span #{multimedia.costoCreditos}
              div(class="boxStatsVideo text-center")
                p Descargas
                span #{multimedia.descargas}

            div(class="grid grid-cols-2 gap-4")
              div(class="boxStatsVideo text-center")
                p Tiempo
                if multimedia.duracion
                  - const m = Math.floor(multimedia.duracion / 60)
                  - const s = multimedia.duracion % 60
                  span #{m}:#{String(s).padStart(2,'0')} Min
                else
                  span N/A
              div(class="boxStatsVideo text-center")
                p Subtitulado
                span(class="center") #{multimedia.subtitulos ? 'Sí' : 'No'}

            div(class="boxStatsVideo text-center")
              p Última vez descargado
              if ultimasDescargas && ultimasDescargas.length
                span #{new Date(ultimasDescargas[0].fechaDescarga).toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' })}
              else
                span Sin descargas

            div(class="boxStatsVideo text-center")
              p Géneros
              if multimedia.GENEROs && multimedia.GENEROs.length
                span #{multimedia.GENEROs.map(g => g.nombre).join(', ')}
              else
                span Sin género

          div(class="mt-12 pt-8 border-t border-white/5")
            div(class="flex items-center gap-3 p-4 bg-white/5 border border-white/10")
              if multimedia.ALBUM && multimedia.ALBUM.cover
                img(alt="Album cover" class="w-8 h-8 opacity-50" src=`${R2_PUBLIC_URL}/images/covers/${multimedia.ALBUM.cover}`)
              div(class="text-[9px] uppercase tracking-widest text-slate-400")
                | #{multimedia.ALBUM ? multimedia.ALBUM.nombreAlbum : 'Single'}
                br
                span(class="text-white font-bold") #{multimedia.ARTISTA ? multimedia.ARTISTA.nombreArtista : ''}

            button(id="btn-editar-datos" class="btn-small btn-green w-full mt-4")
              span(class="material-symbols-outlined") edit
              h5 Editar Datos

            button(id="btn-toggle-estado" class=`btn-small ${multimedia.estado === 'ENABLE' ? 'btn-danger' : 'btn-green'} w-full mt-4`)
              span(class="material-symbols-outlined") #{multimedia.estado === 'ENABLE' ? 'do_not_disturb_on' : 'check_circle'}
              h5 #{multimedia.estado === 'ENABLE' ? 'Suspender Video' : 'Habilitar Video'}

    //- Download Section
    section(class="mt-16")
      div(class="flex items-center gap-4 mb-8")
        h2(class="font-display font-extrabold text-2xl uppercase tracking-tighter")
          | DESCARGAR
          span(class="text-primary")  ARCHIVO
        div(class="flex-grow h-px bg-white/10")

      div(class="grid grid-cols-1 gap-4")
        div(class="group flex flex-col md:flex-row md:items-center justify-between p-6 bg-surface-dark border border-white/5 hover:border-primary/30 transition-all")
          div(class="flex items-center gap-6 mb-4 md:mb-0")
            div(class="w-12 h-12 flex items-center justify-center bg-primary/10 text-primary border border-primary/20")
              span(class="material-symbols-outlined text-3xl font-light") movie
            div
              h4(class="font-display font-bold uppercase tracking-tight text-lg") #{multimedia.nombreComposicion}
              p(class="text-[10px] text-slate-500 uppercase tracking-[0.2em] font-medium")
                | #{multimedia.formato ? multimedia.formato.toUpperCase() : ''} • #{multimedia.tamano ? (multimedia.tamano / (1024*1024)).toFixed(1) + ' MB' : 'N/A'}
          div(class="flex items-center gap-4")
            button(id="btn-request-download" class="bg-primary hover:bg-white hover:text-black text-black px-8 py-3 font-display font-extrabold text-[11px] uppercase tracking-widest transition-all flex items-center gap-2")
              span(class="material-symbols-outlined text-lg") download
              | DESCARGAR

    //- Últimas Descargas Section
    section(class="mt-16")
      div(class="flex items-center gap-4 mb-4")
        h3(class="font-display font-black text-xl uppercase tracking-tighter") Últimas descargas
        div(class="flex-grow h-px bg-white/10")

      div(class="grid grid-cols-1 md:grid-cols-6 gap-2")
        if ultimasDescargas && ultimasDescargas.length
          each descarga in ultimasDescargas
            div(class="flex items-center justify-between p-4 bg-surface-dark border border-white/5 hover:border-primary/40 transition-all")
              div
                h4(class="text-sm font-bold tracking-wide") #{descarga.USUARIO ? descarga.USUARIO.nombreUsuario + ' ' + descarga.USUARIO.apellidoUsuario : 'Usuario'}
                p(class="text-[10px] text-slate-500 uppercase font-mono mt-1") #{descarga.USUARIO ? descarga.USUARIO.emailUsuario : ''}
                p(class="text-[10px] text-slate-500 uppercase font-mono mt-1") #{new Date(descarga.fechaDescarga).toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' })}
        else
          div(class="col-span-6 text-center text-slate-500 text-sm py-8") Sin descargas registradas

        if totalDescargas > 6
          div(class="flex items-center justify-between p-4 bg-surface-dark border border-white/5 hover:border-primary/40 transition-all col-span-1 md:col-span-6 opacity-60 hover:opacity-100")
            span(class="text-[10px] font-bold uppercase tracking-widest") + #{totalDescargas - 6} descargas
            button(class="text-primary text-[10px] font-bold uppercase underline tracking-widest") Ver todas las descargas

//- Modal Editar Datos
div(id="modal-editar-datos" class="fixed inset-0 z-[3000] bg-black/80 backdrop-blur-sm hidden items-center justify-center")
  div(class="glass-card-modal w-full max-w-lg mx-4 p-8 border border-white/10 relative")
    //- Close button
    button(id="modal-close" class="absolute top-4 right-4 text-white/40 hover:text-white p-0 bg-transparent hover:bg-transparent")
      span(class="material-symbols-outlined") close

    h3(class="font-display font-black text-xl uppercase tracking-tighter mb-6") Editar Datos

    div(class="space-y-5")
      //- Nombre composición
      div
        label(for="edit-nombre") Nombre de la composición
        input(id="edit-nombre" type="text" class="ritma-input-field" placeholder="Nombre...")

      //- BPM + Créditos (side by side)
      div(class="flex gap-4")
        div(class="flex-1")
          label(for="edit-bpm") BPM
          input(id="edit-bpm" type="number" class="ritma-input-field" placeholder="128" min="20" max="200")
        div(class="flex-1")
          label(for="edit-creditos") Créditos
          input(id="edit-creditos" type="number" class="ritma-input-field" placeholder="10" min="0")

      //- Album search
      div
        label(for="edit-album") Álbum
        div(class="relative")
          input(id="edit-album" type="text" class="ritma-input-field" placeholder="Buscar álbum..." autocomplete="off")
          div(id="album-autocomplete" class="absolute top-full left-0 w-full mt-1 bg-surface-dark border border-primary/20 shadow-lg z-50 hidden max-h-40 overflow-y-auto")
        input(id="edit-album-id" type="hidden")

      //- Géneros (checkboxes)
      div
        label Géneros
        div(id="generos-container" class="grid grid-cols-2 gap-2 max-h-48 overflow-y-auto custom-scrollbar p-2 border border-white/10 bg-black/20")
          //- Populated by JS

    //- Actions
    div(class="flex items-center justify-end gap-4 mt-8")
      button(id="modal-cancel" class="btn-small btn-ghost") Cancelar
      button(id="modal-save" class="btn-small btn-green") Guardar
