main(class="pt-4 pb-20 relative")
  div(class="absolute inset-0 pixel-grid opacity-20 pointer-events-none")
  
  div(class="max-w-[1400px] mx-auto px-6 relative z-10")
    //- Breadcrumbs
    div(class="flex items-center gap-2 text-[10px] font-bold uppercase tracking-widest text-slate-500 mb-6")
      a(class="hover:text-white transition-colors" href="#") VIDEO GALLERY
      span(class="material-symbols-outlined text-sm") chevron_right
      span(class="text-primary") NEON LATIN NIGHTS VOL. 1

    div(class="grid grid-cols-1 lg:grid-cols-4 gap-6 mb-12")
      //- Video Player Column
      div(class="lg:col-span-3 space-y-6")
        div(class="relative aspect-video bg-surface-dark border border-white/10 video-glow overflow-hidden group")
          img(alt="4K Video Preview" class="w-full h-full object-cover" src="https://lh3.googleusercontent.com/aida-public/AB6AXuCa8J0ghub-DX0DKUyKTOKgXulbacr_Jltk8ThRMPd7I8fjgI-tmXe1Uq9jVmaZWdPXggezbq_f_5IvypyEowW15DfSGg8qVtyeDxkIH8LquGwVG7g67gjuOlLXNSClsSRHZ6ufhf6ig8gArzdRYo7_Loos1gh9_2J77DrK5NhCqE-PkpRPCXz1rSr1FVBnzvrG23aO28BD9VTk7AFpsSoPFMBii_hg5L45tnYUUfx1LeQjt2jkkG5C5YbMR5czVcCBNGZF-_1rWoA")
          
         
         
          //- Video Controls Overlay
          div(class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent flex flex-col justify-end p-6")
            div(class="flex items-center justify-between w-full")
              div(class="flex items-center gap-6")
                button(class="text-white hover:text-primary transition-colors")
                  span(class="material-symbols-outlined text-4xl") play_arrow
                div(class="h-1 w-64 md:w-96 bg-white/20 relative")
                  div(class="absolute top-0 left-0 h-full w-1/3 bg-primary shadow-[0_0_10px_#C9DA2B]")
                span(class="font-mono text-[11px] tracking-tighter") 00:10 / 00:30
              div(class="flex items-center gap-4")
                span(class="px-2 py-0.5 border border-primary text-primary text-[10px] font-bold") 4K ULTRA HD
                button(class="text-white hover:text-primary transition-colors")
                  span(class="material-symbols-outlined") fullscreen

          //- Live Badge
          div(class="absolute top-6 left-6 flex items-center gap-2 px-3 py-1 bg-black/60 backdrop-blur-md border border-white/10")
            div(class="w-2 h-2 rounded-full bg-primary animate-pulse")
            span(class="text-[10px] font-bold tracking-[0.2em] uppercase") On-line

        //- Video Info Header
        div(class="flex flex-col md:flex-row md:items-center justify-between gap-4")
          div
            h1(class="font-display font-extrabold text-4xl md:text-5xl uppercase tracking-tighter leading-none mb-3")
              | Cosas Pendientes
            div(class="flex flex-wrap gap-4 text-slate-400 text-xs font-medium uppercase tracking-widest")
              span(class="flex items-center gap-1")
                span(class="material-symbols-outlined text-sm") person
                | Maluma
              span(class="flex items-center gap-1")
                span(class="material-symbols-outlined text-sm") schedule
                | SUBIDO HACE 2 DÍAS
              span(class="flex items-center gap-1 text-primary")
                span(class="material-symbols-outlined text-sm") currency_rupee_circle
                | 5 Créditos
          div(class="flex gap-2")
            button(class="p-3 border border-white/10 hover:bg-white/5 transition-colors")
              span(class="material-symbols-outlined") share
            button(class="p-3 border border-white/10 hover:bg-white/5 transition-colors")
              span(class="material-symbols-outlined") favorite

      //- Sidebar Stats
      div(class="lg:col-span-1 md:col-span-3")
        div(class="glass-card border border-white/10 p-6 h-full")
          h3(class="font-display font-bold text-[10px] uppercase tracking-[0.2em] text-slate-500  flex items-center gap-2")
          span(class="material-symbols-outlined mr-3 mt-1 mb-5") stacked_line_chart
          | ESTADÍSTICAS TÉCNICAS


            
          div(class="space-y-2")
            div(class="grid grid-cols-2 gap-4")
                div(class="boxStatsVideo text-center")
                    p Créditos
                    span 5
                div(class="boxStatsVideo text-center")
                    p  Descargas
                    span 23
            
            
            div(class="grid grid-cols-2 gap-4")
                div(class="boxStatsVideo text-center")
                  p Tiempo
                  span 3:40 Min
                div(class="boxStatsVideo text-center")
                  p Subtitulado
                  span(class="center") No

            div(class="boxStatsVideo text-center")
              p Últuma vez descargado
              span 10 enero 2025


            div(class="boxStatsVideo text-center")
              p  Aspect Ratio
              span 16:9
            
          
          div(class="mt-12 pt-8 border-t border-white/5")
            div(class="flex items-center gap-3 p-4 bg-white/5 border border-white/10")
              img(alt="Lightning Bolt" class="w-8 h-8 opacity-50" src="https://pub-ce8d352182044cd18b3dcb751f592c1d.r2.dev/images/covers/c6d69df7-dcb7-46e1-b5d0-11abcb9ab4c9.webp")
              div(class="text-[9px] uppercase tracking-widest text-slate-400")
                | Nombre del Album
                br
                span(class="text-white font-bold") Petry boy dirty boy

            button( class="btn-small btn-green w-full mt-4")
                span(class="material-symbols-outlined text-black") movie_edit
                h5 Editar Datos
            button( class="btn-small btn-danger w-full mt-4")
                span(class="material-symbols-outlined") do_not_disturb_on
                h5 Suspender Video 
                






    //- Files Section
    section(class="mt-16")
      div(class="flex items-center gap-4 mb-8")
        h2(class="font-display font-extrabold text-2xl uppercase tracking-tighter")
          | INFRAESTRUCTURA DE 
          span(class="text-primary") ARCHIVOS
        div(class="flex-grow h-px bg-white/10")

      div(class="grid grid-cols-1 gap-4")
        //- File Row (Example: Master Video)
        div(class="group flex flex-col md:flex-row md:items-center justify-between p-6 bg-surface-dark border border-white/5 hover:border-primary/30 transition-all")
          div(class="flex items-center gap-6 mb-4 md:mb-0")
            div(class="w-12 h-12 flex items-center justify-center bg-primary/10 text-primary border border-primary/20")
              span(class="material-symbols-outlined text-3xl font-light") movie
            div
              h4(class="font-display font-bold uppercase tracking-tight text-lg") FULL 4K MASTER VIDEO
              p(class="text-[10px] text-slate-500 uppercase tracking-[0.2em] font-medium") Archivo original sin comprimir • 1.2 GB • .MP4
          div(class="flex items-center gap-4")
            div(class="hidden md:block text-right")
              p(class="text-[9px] text-slate-500 uppercase tracking-widest") LICENCIA
              p(class="text-[10px] text-white font-bold uppercase") Uso Comercial
            button(class="bg-primary hover:bg-white hover:text-black text-black px-8 py-3 font-display font-extrabold text-[11px] uppercase tracking-widest transition-all flex items-center gap-2")
              span(class="material-symbols-outlined text-lg") download
              | DESCARGAR