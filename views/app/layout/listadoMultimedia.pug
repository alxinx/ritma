div(class="space-y-6")
  div(class="glass-card rounded-2xl p-4 flex flex-wrap gap-4 items-center overflow-visible relative z-20")
    div(class="flex-1 min-w-[200px] relative")
      +ritmaInput("searchMultimedia", "searchMultimedia", type='text', "", required=false, "Filtra por artista, nombre de la canción o formato", icon='search' , autocompleteType = 'on' )

    div(class="flex gap-4 z-50")
      //- Buscar por artista o composicion
      +customSelect("buscarpor", "buscarpor", "", "artista", [
          {label: "Artista", value: "artista", selected: true},
          {label: "Composición", value: "composicion"}
      ])

      div(class="flex gap-4 z-50")
      //- Filtro por formato
      +customSelect("formatosBusqueda", "formatosBusqueda", "", "Formatos ", [
          {label: "Todos los formatos", value: "all", selected: true},
          {label: "Audio", value: "audio"},
          {label: "Video", value: "video"}
      ])

      //- Filtro por rango de BPM (Double Range Slider)
      div(class="flex items-end pt-4 min-w-[180px]")
        div(class="w-full space-y-1")
          label(class="text-[10px] font-mono font-bold text-primary uppercase tracking-widest block") BPM
          div(class="bpm-range-slider relative w-full" data-min="20" data-max="200")
            //- Tooltip
            div(id="bpm-tooltip" class="bpm-tooltip hidden")
              span(id="bpm-tooltip-text" class="text-[11px] font-mono font-bold text-black")
            //- Track
            div(class="bpm-track")
              div(id="bpm-track-fill" class="bpm-track-fill")
            //- Range inputs
            input(type="range" id="bpmMin" min="20" max="200" value="20" class="bpm-thumb bpm-thumb-min")
            input(type="range" id="bpmMax" min="20" max="200" value="200" class="bpm-thumb bpm-thumb-max")

      //- Boton para abrir modal de generos
      div(class="pt-4 flex flex-col gap-6 w-full")
        button(type="button" id="btn-abrir-generos" class="btn-green w-full group relative overflow-hidden")
          div(class="absolute inset-0 bg-white/10 translate-x-[-100%] group-hover:translate-x-[100%] transition-transform duration-700")
          h4 Generos
          span(class="material-symbols-outlined text-black transition-transform group-hover:translate-x-1") filter_list

    //- Pills de generos seleccionados
    div(id="contenedor-pills-generos" class="flex flex-wrap gap-2 w-full")
    input(type="hidden" name="generos" id="generosSeleccionados" value="")

  div(class="glass-card rounded-3xl overflow-hidden")
    table(class="w-full text-left border-collapse")
      thead
        tr(class="border-b border-white/5 bg-white/2")
          th(class="px-8 py-5 text-[10px] font-bold text-gray-400 uppercase tracking-widest") Tendencia
          th(class="px-8 py-5 text-[10px] font-bold text-gray-400 uppercase tracking-widest") Artista
          th(class="px-8 py-5 text-[10px] font-bold text-gray-400 uppercase tracking-widest") Composición
          th(class="px-8 py-5 text-[10px] font-bold text-gray-400 uppercase tracking-widest") Formato
          th(class="px-8 py-5 text-[10px] font-bold text-gray-400 uppercase tracking-widest") Estado
          th(class="px-8 py-5 text-[10px] font-bold text-gray-400 uppercase tracking-widest text-right") Downloads
          th(class="px-8 py-5 text-[10px] font-bold text-gray-400 uppercase tracking-widest text-center")
      tbody(id="multimedia-tbody" class="divide-y divide-white/5 font-mono text-sm")
        //- Las filas se renderizan dinamicamente via JS

    div(id="pagination-footer" class="px-8 py-4 bg-black/40 flex items-center justify-between")
      span(id="total-elementos" class="subtittle tracking-widest") Cargando...
      div(id="pagination-buttons" class="flex gap-2")

//- MODAL GENEROS
div(id="modal-generos" class="fixed inset-0 z-[3000] flex items-center justify-center bg-black/80 hidden")
  div(class="glass-card w-full max-w-2xl p-8 rounded-3xl border border-white/10")
    h3.text-primary.tracking-widest.font-display.text-center.mb-4 Selecciona los géneros
    div(class="relative mb-6")
      +ritmaInput("busqueda-genero-modal", "busqueda-genero-modal", "text", "", true, "BUSCAR GÉNERO...", "search")
    div(id="lista-generos-modal" class="grid grid-cols-2 md:grid-cols-3 gap-3 max-h-96 overflow-y-auto p-2 custom-scrollbar")
    div(class="flex justify-end gap-4 mt-8")
      button(type="button" id="btn-cerrar-modal" class="px-6 py-2 text-xs font-bold uppercase text-gray-400 hover:text-white") Cancelar
      button(type="button" id="btn-aceptar-generos" class="px-6 py-2 bg-primary text-black text-xs font-bold uppercase rounded-lg hover:brightness-110") Aceptar
