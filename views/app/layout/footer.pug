footer(class="fixed bottom-0 left-0 w-full h-12 glass-header grid grid-cols-3 items-center px-10 text-[10px] font-bold text-gray-500 uppercase tracking-[0.2em] z-30")
  //- LEFT
  div(class="flex items-center gap-3")
    span(class="size-2 rounded-full bg-primary animate-pulse shadow-[0_0_8px_#C9DA2B]")
    span(class="text-white") CORE_SYSTEM: RUNNING

  //- CENTER
  div(class="flex items-center justify-center gap-4")
    span ADMIN_LEVEL: ROOT
    span(class="text-white/10 text-lg font-thin") |
    span UPTIME: 342D 12H

  //- RIGHT
  div(class="flex items-center justify-end gap-4")
    a(class="hover:text-primary transition-colors" href="#") DEBUG MODE
    span(class="text-white/10 text-lg font-thin") |
    span(class="text-primary/50 font-mono tracking-normal") #{process.env.APP_NAME} #{process.env.APP_VERSION}
